NODE_ENV=development
SERVICE_ROLE=api
API_PORT=3001
WORKER_METRICS_PORT=9464
# Explicit local-only bypass. Production API validation requires clamd.
CLAMAV_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
WEB_ORIGIN=http://localhost:3130
# Single-organization web deployment. The login page sends this value automatically.
WEB_ORGANIZATION_CODE=ACADEMYOPS
# All three web API boundaries below are required for production builds.
API_ORIGIN=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001/api/v1
# Use the public API origin that hosts Socket.IO.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
DATABASE_URL=postgresql://plg:plg_dev_only@localhost:55432/plg_academy?schema=public
DIRECT_URL=postgresql://plg:plg_dev_only@localhost:55432/plg_academy?schema=public
REDIS_URL=redis://localhost:16379
SESSION_PEPPER=replace-with-at-least-32-random-bytes
QR_HMAC_SECRET=replace-with-at-least-32-random-bytes
FILE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
MFA_RECOVERY_PEPPER=replace-with-at-least-32-random-bytes
METRICS_TOKEN=
# Shared only by API, worker, and the isolated WhatsApp Web connector.
OTP_CONNECTOR_INTERNAL_TOKEN=
OTP_CONNECTOR_URL=http://localhost:3002
PASSWORD_RESET_PEPPER=replace-with-at-least-32-random-bytes
PHONE_OTP_PEPPER=replace-with-at-least-32-random-bytes
ACTION_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Optional for local API boot. Required before QR pairing; production requires it.
# Generate exactly 32 random bytes as base64 and share it only with the API and connector.
WHATSAPP_AUTH_ENCRYPTION_KEY=
LEGACY_ARCHIVE_KEY=replace-with-32-byte-base64-key
# Paymob is disabled until every value below is configured. Use test credentials first.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PAYMENT_METHOD_IDS=
PAYMOB_NOTIFICATION_URL=http://localhost:3100/api/v1/webhooks/paymob/transaction
PAYMOB_REDIRECTION_URL=http://localhost:3100/ar/payments/paymob/return
# Generate exactly 32 random bytes and encode them as base64.
PAYMOB_CHECKOUT_ENCRYPTION_KEY=
# Local Docker captures messages in Mailpit at http://localhost:58025.
# Production points these values at the private Postal SMTP endpoint.
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_TLS_SERVERNAME=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@notify.example.test
SMTP_FROM_NAME=AcademyOps
SMTP_RETURN_PATH=bounce@notify.example.test
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=plg-academy-dev
# Development fallback only; production should configure all R2 values above.
PRIVATE_FILE_STORAGE_ROOT=../../work/private-files
