{
  "name": "@academyops/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    "./worker": {
      "types": "./dist/worker.module.d.ts",
      "require": "./dist/worker.module.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test --maxWorkers=1",
    "test:http:matrix": "node scripts/run-http-route-matrix.mjs",
    "test:http:rate-limit": "vitest run test/http/rate-limit-http.integration.test.ts --maxWorkers=1",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:accounts:dev": "ts-node --transpile-only prisma/dev-accounts.ts",
    "prisma:fixture:e2e": "ts-node --transpile-only prisma/e2e-fixture.ts",
    "prisma:fixture:load": "ts-node --transpile-only prisma/load-fixture.ts",
    "import:inspect": "ts-node --transpile-only scripts/inspect-workbook.ts",
    "openapi:emit": "nest build && node dist/openapi-cli.js && pnpm openapi:responses",
    "openapi:responses": "node ../../scripts/generate-openapi-response-types.mjs && node ../../scripts/enrich-openapi-responses.mjs && node ../../scripts/generate-api-catalog.mjs && node ../../scripts/check-openapi-contract.mjs",
    "prisma:seed:ui": "ts-node --transpile-only prisma/seed-ui-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "11.1.28",
    "@academyops/contracts": "workspace:*",
    "@prisma/client": "6.19.2",
    "argon2": "0.45.1",
    "bullmq": "5.66.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "ioredis": "5.8.2",
    "libphonenumber-js": "1.13.15",
    "nodemailer": "10.2.1",
    "prisma": "6.19.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.1",
    "dotenv": "16.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "vitest": "4.1.10"
  }
}
