model Refund {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  refundRequestId String   @map("refund_request_id") @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  ledgerEntryId   String   @map("ledger_entry_id") @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  processedBy     String   @map("processed_by") @db.Uuid
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, refundRequestId])
  @@unique([organizationId, ledgerEntryId])
  @@index([organizationId, paymentId])
  @@map("refunds")
}

model IdempotencyRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  operation      String    @db.VarChar(80)
  key            String    @db.VarChar(128)
  requestHash    String    @map("request_hash") @db.VarChar(128)
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body") @db.JsonB
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
