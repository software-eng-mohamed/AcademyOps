{
  "name": "@academyops/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "orval --config orval.config.ts",
    "api:check": "node scripts/check-generated-api.mjs && node scripts/check-api-boundaries.mjs",
    "build": "next build --turbopack",
    "dev": "node scripts/start-dev.mjs",
    "format": "biome format --write src test scripts next.config.ts orval.config.ts vitest.config.ts",
    "lint": "biome check src test scripts next.config.ts orval.config.ts vitest.config.ts",
    "start": "node scripts/start-standalone.mjs",
    "test": "vitest run",
    "test:dev-start": "node --test scripts/wait-for-dev-api.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.7.1",
    "@nivo/bar": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/pie": "0.99.0",
    "@academyops/api-client": "workspace:*",
    "@academyops/design-tokens": "workspace:*",
    "@academyops/ui": "workspace:*",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "dotenv": "16.6.1",
    "gsap": "3.15.0",
    "iconsax-react": "0.0.8",
    "jsqr": "1.4.0",
    "lucide-react": "1.31.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.15.2",
    "posthog-js": "1.428.7",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-aria-components": "1.17.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "tailwind-merge": "3.6.0",
    "web-vitals": "6.2.1",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "orval": "8.26.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
