# ==============================================================================
# AcademyOps - VPS 1 (Frontend & Observability) Runtime Environment
# ==============================================================================

# Public Domain & Ingress
SITE_ADDRESS=academy.example.com
PUBLIC_ORIGIN=https://academy.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=local

# Private IP Addresses of the Cluster (WireGuard or Cloud VPC)
VPS1_PRIVATE_IP=10.10.0.1
VPS2_PRIVATE_IP=10.10.0.2
VPS3_PRIVATE_IP=10.10.0.3

# Shared Metrics Scrape Secret (Must match METRICS_TOKEN on VPS 2)
METRICS_TOKEN=GENERATE_64_HEX_CHARS

# Observability Suite Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD
ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/plg-cluster
ALERTMANAGER_MEM_LIMIT=256m
ALERTMANAGER_CPUS=0.25

# Container Limits
WEB_MEM_LIMIT=1g
WEB_CPUS=1.0
CADDY_MEM_LIMIT=256m
CADDY_CPUS=0.5
NEXT_PUBLIC_OBSERVABILITY_ENVIRONMENT=production

# PostHog Product Analytics (Cloud — https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=SET_ME
NEXT_PUBLIC_POSTHOG_HOST=/e
POSTHOG_INGEST_HOST=us.i.posthog.com
