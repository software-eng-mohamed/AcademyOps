# ==============================================================================
# AcademyOps - VPS 2 (Backend, Worker, WhatsApp OTP) Environment Configuration
# ==============================================================================

# Image release tag
IMAGE_TAG=local

# Public origin (Caddy on VPS 1)
PUBLIC_ORIGIN=https://academy.example.com

# Private Cluster IPs (WireGuard mesh: 10.10.0.0/24)
VPS1_PRIVATE_IP=10.10.0.1
VPS2_PRIVATE_IP=10.10.0.2
VPS3_PRIVATE_IP=10.10.0.3

# Remote Database & Cache on VPS 3
API_DATABASE_URL=postgresql://plg_app:GENERATE_APP_PASSWORD@10.10.0.3:5432/plg_prod?schema=public&connection_limit=35&pool_timeout=10
WORKER_DATABASE_URL=postgresql://plg_app:GENERATE_APP_PASSWORD@10.10.0.3:5432/plg_prod?schema=public&connection_limit=10&pool_timeout=10
MIGRATE_DATABASE_URL=postgresql://plg_migrate:GENERATE_MIGRATE_PASSWORD@10.10.0.3:5432/plg_prod?schema=public&connection_limit=5&pool_timeout=10
REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@10.10.0.3:6379/0

# Cryptographic Keys & Secrets (Must match cluster-wide secrets)
METRICS_TOKEN=GENERATE_METRICS_TOKEN
ACTION_TOKEN_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS
SESSION_PEPPER=GENERATE_64_HEX_CHARS
QR_HMAC_SECRET=GENERATE_64_HEX_CHARS
FILE_SIGNING_SECRET=GENERATE_64_HEX_CHARS
MFA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS
MFA_RECOVERY_PEPPER=GENERATE_64_HEX_CHARS
PASSWORD_RESET_PEPPER=GENERATE_64_HEX_CHARS
PHONE_OTP_PEPPER=GENERATE_64_HEX_CHARS
WHATSAPP_AUTH_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64
OTP_CONNECTOR_INTERNAL_TOKEN=GENERATE_64_HEX_CHARS
LEGACY_ARCHIVE_KEY=GENERATE_64_HEX_CHARS

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=plg-academy-production

# Paymob Gateway
PAYMOB_SECRET_KEY=SET_ME
PAYMOB_PUBLIC_KEY=SET_ME
PAYMOB_HMAC_SECRET=SET_ME
PAYMOB_PAYMENT_METHOD_IDS=12345,67890
PAYMOB_CHECKOUT_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64

# Transactional SMTP Mailer
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=
SMTP_USERNAME=apikey
SMTP_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
SMTP_FROM_EMAIL=notifications@academy.example.com
SMTP_FROM_NAME="AcademyOps"
SMTP_RETURN_PATH=bounces@academy.example.com

# Resource Limits
API_MEM_LIMIT=1536m
API_CPUS=1.5
WORKER_MEM_LIMIT=1g
WORKER_CPUS=1.0
OTP_CONNECTOR_MEM_LIMIT=2g
OTP_CONNECTOR_CPUS=1.5
CLAMAV_MEM_LIMIT=4g
CLAMAV_CPUS=1.0
