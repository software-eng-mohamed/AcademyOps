# ==============================================================================
# AcademyOps - VPS 3 (PostgreSQL & Redis) Environment Configuration
# ==============================================================================

# Private Cluster IPs (WireGuard mesh: 10.10.0.0/24)
VPS1_PRIVATE_IP=10.10.0.1
VPS2_PRIVATE_IP=10.10.0.2
VPS3_PRIVATE_IP=10.10.0.3

# PostgreSQL 17 Master Credentials
POSTGRES_DB=plg_prod
POSTGRES_USER=plg_admin
POSTGRES_PASSWORD=GENERATE_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=GENERATE_APP_PASSWORD
POSTGRES_MIGRATE_PASSWORD=GENERATE_MIGRATE_PASSWORD
POSTGRES_EXPORTER_PASSWORD=GENERATE_EXPORTER_PASSWORD

# Redis 7.4 Master Password
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD
REDIS_MAXMEMORY=768mb

# Resource Limits
POSTGRES_MEM_LIMIT=3g
POSTGRES_CPUS=2.0
REDIS_MEM_LIMIT=1g
REDIS_CPUS=0.75

# Offsite Backup (Optional)
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_DESTINATION=
