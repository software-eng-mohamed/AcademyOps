[Interface]
PrivateKey = ${VPS3_WG_PRIVATE_KEY}
Address = 10.10.0.3/24
ListenPort = 51820

# Peer: VPS 1 (Frontend & Monitoring)
[Peer]
PublicKey = ${VPS1_WG_PUBLIC_KEY}
