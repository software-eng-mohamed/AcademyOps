{
	admin off
	servers {
		protocols h1 h2 h3
		timeouts {
			read_body 120s
			read_header 10s
			write 120s
			idle 2m
		}
		max_header_size 32KB
	}
}

# Production Site Configuration
{$SITE_ADDRESS} {
	encode zstd gzip

	# Block private/internal metrics endpoints from external access
	@internalMetrics path /api/v1/internal/metrics
	respond @internalMetrics "Not Found" 404

	# Block private/internal OTP connector endpoints from external access
	@internalOtpConnector path /api/v1/internal/otp-connector /api/v1/internal/otp-connector/*
	respond @internalOtpConnector "Not Found" 404

	# Health check endpoint for container healthchecks
	handle /health {
		respond "OK" 200
	}

	# API and Realtime WebSocket routes load-balanced across API instances
	@backend path /api/* /socket.io /socket.io/*
	reverse_proxy @backend api-a:3001 api-b:3001 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 30s
		max_fails 3
		health_uri /api/v1/health/live
		health_interval 15s
		health_timeout 3s
	}

	# Frontend Next.js Standalone
	reverse_proxy web:3100 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	log {
		output stdout
		format json
	}
}
