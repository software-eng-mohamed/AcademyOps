# ==============================================================================
# AcademyOps - Single VPS Production Configuration
# Copy this file to runtime.env: cp runtime.env.example runtime.env
# Run scripts/generate-secrets.sh to automatically populate all cryptographic keys.
# ==============================================================================

# Domain and Ingress
SITE_ADDRESS=academy.example.com
PUBLIC_ORIGIN=https://academy.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=local

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=plg_academy
POSTGRES_USER=plg_bootstrap
POSTGRES_PASSWORD=GENERATE_64_HEX_CHARS
POSTGRES_APP_PASSWORD=GENERATE_64_HEX_CHARS
POSTGRES_MIGRATE_PASSWORD=GENERATE_64_HEX_CHARS
POSTGRES_EXPORTER_PASSWORD=GENERATE_64_HEX_CHARS

# Connection strings using isolated roles
API_DATABASE_URL=postgresql://plg_app:GENERATE_64_HEX_CHARS@postgres:5432/plg_academy?schema=public&connection_limit=35&pool_timeout=10
WORKER_DATABASE_URL=postgresql://plg_app:GENERATE_64_HEX_CHARS@postgres:5432/plg_academy?schema=public&connection_limit=10&pool_timeout=10
DIRECT_URL=postgresql://plg_migrate:GENERATE_64_HEX_CHARS@postgres:5432/plg_academy?schema=public&connection_limit=5&pool_timeout=10
POSTGRES_EXPORTER_DSN=postgresql://plg_monitor:GENERATE_64_HEX_CHARS@postgres:5432/plg_academy?sslmode=disable

# Cache & Message Transport (Redis 7)
REDIS_PASSWORD=GENERATE_64_HEX_CHARS
REDIS_URL=redis://:GENERATE_64_HEX_CHARS@redis:6379/0
REDIS_MAXMEMORY=768mb

# Application Cryptographic Secrets (Hexadecimal - min 48-64 characters)
SESSION_PEPPER=GENERATE_64_HEX_CHARS
QR_HMAC_SECRET=GENERATE_64_HEX_CHARS
FILE_SIGNING_SECRET=GENERATE_64_HEX_CHARS
MFA_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS
MFA_RECOVERY_PEPPER=GENERATE_64_HEX_CHARS
METRICS_TOKEN=GENERATE_64_HEX_CHARS
OTP_CONNECTOR_INTERNAL_TOKEN=GENERATE_64_HEX_CHARS
PASSWORD_RESET_PEPPER=GENERATE_64_HEX_CHARS
PHONE_OTP_PEPPER=GENERATE_64_HEX_CHARS
ACTION_TOKEN_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS
LEGACY_ARCHIVE_KEY=GENERATE_64_HEX_CHARS

# Base64 Encryption Keys (Exactly 32 raw random bytes encoded as base64)
WHATSAPP_AUTH_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64
PAYMOB_CHECKOUT_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64

# ClamAV Antivirus Scanner
CLAMAV_TIMEOUT_MS=5000

# Payment Gateway (Paymob Egypt - Production Credentials)
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=SET_ME
PAYMOB_PUBLIC_KEY=SET_ME
PAYMOB_HMAC_SECRET=SET_ME
PAYMOB_PAYMENT_METHOD_IDS=SET_ME

# Cloudflare R2 / S3 Object Storage (Private Bucket)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=plg-academy-production
STORAGE_ADDRESS=files.example.com

# Email Delivery (Authenticated TLS SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=smtp.example.com
SMTP_USERNAME=...
SMTP_PASSWORD=...
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AcademyOps
SMTP_RETURN_PATH=bounce@example.com

# Observability (Grafana & Alertmanager)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD
ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/plg-production
ALERTMANAGER_MEM_LIMIT=256m
ALERTMANAGER_CPUS=0.25

# Container Resource Limits
WEB_MEM_LIMIT=1g
WEB_CPUS=1.0
CADDY_MEM_LIMIT=256m
CADDY_CPUS=0.5
API_MEM_LIMIT=1536m
API_CPUS=1.5
WORKER_MEM_LIMIT=1g
WORKER_CPUS=1.0
OTP_CONNECTOR_MEM_LIMIT=2g
OTP_CONNECTOR_CPUS=1.5
POSTGRES_MEM_LIMIT=3g
POSTGRES_CPUS=2.0
REDIS_MEM_LIMIT=1g
REDIS_CPUS=0.75
CLAMAV_MEM_LIMIT=4g
CLAMAV_CPUS=1.0
