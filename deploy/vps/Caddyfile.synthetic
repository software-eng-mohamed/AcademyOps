{
	admin off
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2 h3
		timeouts {
			read_body 120s
			read_header 10s
			write 120s
			idle 2m
		}
		max_header_size 32KB
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	@internalMetrics path /api/v1/internal/metrics
	respond @internalMetrics 404
	@internalOtpConnector path /api/v1/internal/otp-connector /api/v1/internal/otp-connector/*
	respond @internalOtpConnector 404

	@backend path /api/* /socket.io /socket.io/*
	reverse_proxy @backend api-a:3001 api-b:3001 {
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 30s
		max_fails 3
		health_uri /api/v1/health/live
		health_interval 15s
		health_timeout 3s
	}

	import /etc/caddy/optional/*.caddy
	reverse_proxy web:3100

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	log {
		output stdout
		format json
	}
}

{$STORAGE_ADDRESS} {
	reverse_proxy minio:9000
	header {
		-Server
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
}
