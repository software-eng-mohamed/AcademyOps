# Copy to runtime.env, chmod 600, and replace every SET_ME value.
SITE_ADDRESS=academy.example.com
PUBLIC_ORIGIN=https://academy.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=local

# Production ingress is a remotely managed Cloudflare Tunnel. Put only the token in
# runtime/cloudflared-token (owner 65532:65532, mode 400); configure the academy
# hostname -> http://caddy:8080
# plus a final http_status:404 rule. The synthetic overlay is the only direct-port path.

# Keep the 5s client timeout below the clamd/readiness thresholds.
CLAMAV_TIMEOUT_MS=5000

POSTGRES_DB=plg_academy
POSTGRES_USER=plg_bootstrap
# Generate each database/Redis password independently with: openssl rand -hex 32
POSTGRES_PASSWORD=SET_ME
POSTGRES_APP_PASSWORD=SET_ME
POSTGRES_MIGRATE_PASSWORD=SET_ME
POSTGRES_EXPORTER_PASSWORD=SET_ME
API_DATABASE_URL=postgresql://plg_app:SET_ME@postgres:5432/plg_academy?schema=public&connection_limit=35&pool_timeout=10
WORKER_DATABASE_URL=postgresql://plg_app:SET_ME@postgres:5432/plg_academy?schema=public&connection_limit=10&pool_timeout=10
DIRECT_URL=postgresql://plg_migrate:SET_ME@postgres:5432/plg_academy?schema=public&connection_limit=5&pool_timeout=10
POSTGRES_EXPORTER_DSN=postgresql://plg_monitor:SET_ME@postgres:5432/plg_academy?sslmode=disable
REDIS_PASSWORD=SET_ME
REDIS_URL=redis://:SET_ME@redis:6379/0
REDIS_MAXMEMORY=768mb

# Generate each independently: openssl rand -hex 32
SESSION_PEPPER=SET_ME
QR_HMAC_SECRET=SET_ME
FILE_SIGNING_SECRET=SET_ME
MFA_ENCRYPTION_KEY=SET_ME
MFA_RECOVERY_PEPPER=SET_ME
METRICS_TOKEN=SET_ME
OTP_CONNECTOR_INTERNAL_TOKEN=SET_ME
PASSWORD_RESET_PEPPER=SET_ME
PHONE_OTP_PEPPER=SET_ME
ACTION_TOKEN_ENCRYPTION_KEY=SET_ME
LEGACY_ARCHIVE_KEY=SET_ME
# Generate each independently: openssl rand -base64 32
WHATSAPP_AUTH_ENCRYPTION_KEY=SET_ME
PAYMOB_CHECKOUT_ENCRYPTION_KEY=SET_ME

# Use sandbox credentials for synthetic validation; rotate before real go-live.
PAYMOB_SECRET_KEY=SET_ME
PAYMOB_PUBLIC_KEY=SET_ME
PAYMOB_HMAC_SECRET=SET_ME
PAYMOB_PAYMENT_METHOD_IDS=SET_ME

# Cloudflare R2 for real deployment. compose.synthetic.yml can use private MinIO.
R2_ENDPOINT=https://SET_ME.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=SET_ME
R2_SECRET_ACCESS_KEY=SET_ME
R2_BUCKET=plg-academy-private
STORAGE_ADDRESS=files.example.com

# Real deployment requires authenticated TLS SMTP. The synthetic overlay overrides these.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_SERVERNAME=smtp.example.com
SMTP_USERNAME=SET_ME
SMTP_PASSWORD=SET_ME
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AcademyOps
SMTP_RETURN_PATH=bounce@example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SET_ME
# HTTPS webhook owned by the on-call system outside this VPS. The URL is a secret.
ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/SET_ME
ALERTMANAGER_MEM_LIMIT=256m
ALERTMANAGER_CPUS=0.25

# Product analytics is optional and separate from Prometheus/Grafana monitoring.
NEXT_PUBLIC_OBSERVABILITY_ENVIRONMENT=production
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_INGEST_HOST=us.i.posthog.com

# Tune only after measuring the actual VPS.
WEB_MEM_LIMIT=1g
WEB_CPUS=1.0
CADDY_MEM_LIMIT=256m
CADDY_CPUS=0.5
CLOUDFLARED_MEM_LIMIT=256m
CLOUDFLARED_CPUS=0.5
API_MEM_LIMIT=1536m
API_CPUS=1.5
WORKER_MEM_LIMIT=1g
WORKER_CPUS=1.0
OTP_CONNECTOR_MEM_LIMIT=2g
OTP_CONNECTOR_CPUS=1.5
POSTGRES_MEM_LIMIT=3g
POSTGRES_CPUS=2.0
# The compressed PostgreSQL dump must fit in this RAM-backed workspace.
BACKUP_WORK_TMPFS_SIZE=4g
BACKUP_TOOL_MEM_LIMIT=5g
BACKUP_TOOL_CPUS=1.0
REDIS_MEM_LIMIT=1g
CLAMAV_MEM_LIMIT=4g
CLAMAV_CPUS=1.0
REDIS_CPUS=0.75
