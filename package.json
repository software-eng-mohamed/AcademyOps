{
  "name": "academyops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build --filter=@academyops/api --filter=@academyops/worker --filter=@academyops/web --filter=@academyops/otp-connector",
    "build:web": "pnpm --filter @academyops/contracts build && pnpm --filter @academyops/api-client build && pnpm --filter @academyops/ui build && pnpm --filter @academyops/web build",
    "build:verify": "node scripts/run-production-build.mjs",
    "dev": "turbo run dev --parallel --filter=@academyops/api --filter=@academyops/worker --filter=@academyops/web",
    "dev:local": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-local.ps1",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/journey-config.test.mjs scripts/cluster-secret-output.test.mjs && pnpm --filter @academyops/web test:dev-start",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:list": "playwright test --config tests/e2e/playwright.config.ts --list",
    "e2e:lint": "eslint tests/e2e --max-warnings=0",
    "e2e:typecheck": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "e2e:report": "playwright show-report test-results/e2e/report",
    "e2e:roles": "playwright test --config tests/web-final/playwright.live.config.ts",
    "web:e2e": "playwright test --config tests/web/playwright.config.ts",
    "web:e2e:list": "playwright test --config tests/web/playwright.config.ts --list",
    "web:e2e:lint": "eslint tests/web --max-warnings=0",
    "web:e2e:typecheck": "tsc -p tests/web/tsconfig.json --noEmit",
    "web:verify": "pnpm --filter @academyops/contracts build && pnpm --filter @academyops/api-client lint && pnpm --filter @academyops/api-client typecheck && pnpm --filter @academyops/api-client test && pnpm --filter @academyops/api-client build && pnpm --filter @academyops/ui lint && pnpm --filter @academyops/ui typecheck && pnpm --filter @academyops/ui test && pnpm --filter @academyops/ui build && pnpm --filter @academyops/web api:check && pnpm --filter @academyops/web lint && pnpm --filter @academyops/web typecheck && pnpm --filter @academyops/web test && pnpm web:e2e:lint && pnpm web:e2e:typecheck && pnpm --filter @academyops/web build",
    "e2e:fixture:seed": "pnpm --filter @academyops/api prisma:fixture:e2e seed",
    "e2e:fixture:verify": "pnpm --filter @academyops/api prisma:fixture:e2e verify",
    "e2e:fixture:clean": "pnpm --filter @academyops/api prisma:fixture:e2e clean",
    "e2e:fixture:typecheck": "tsc -p apps/api/prisma/tsconfig.json",
    "load:build": "tsc -p tests/load/tsconfig.json",
    "load:typecheck": "tsc -p tests/load/tsconfig.json --noEmit",
    "load:lint": "eslint tests/load apps/api/prisma/load-fixture.ts apps/api/prisma/load-fixture --max-warnings=0",
    "load:test": "pnpm load:build && node --test test-results/load/dist/unit/*.test.js",
    "load:list": "pnpm load:build && node test-results/load/dist/tools/list-profiles.js",
    "load:prepare": "pnpm load:build && node test-results/load/dist/tools/prepare-output.js",
    "load:http": "pnpm load:prepare && k6 run tests/load/k6/http-workload.mjs",
    "load:realtime": "pnpm load:build && node test-results/load/dist/realtime/run.js",
    "load:gate": "pnpm load:build && node test-results/load/dist/tools/aggregate-gate.js",
    "load:fixture:seed": "pnpm --filter @academyops/api prisma:fixture:load seed",
    "load:fixture:verify": "pnpm --filter @academyops/api prisma:fixture:load verify",
    "load:fixture:clean": "pnpm --filter @academyops/api prisma:fixture:load clean",
    "load:fixture:typecheck": "tsc -p apps/api/prisma/tsconfig.json",
    "load:verify": "pnpm load:lint && pnpm load:typecheck && pnpm load:fixture:typecheck && pnpm load:test && pnpm load:list",
    "max-lines": "pnpm --filter @academyops/line-gate build && node packages/line-gate/dist/cli.js",
    "test:gate": "pnpm --filter @academyops/line-gate test",
    "dependencies:check": "node scripts/check-pinned-dependencies.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=moderate && pnpm --filter @academyops/otp-connector test",
    "licenses:check": "pnpm licenses list --prod --json | node scripts/check-production-licenses.mjs",
    "db:generate": "pnpm --filter @academyops/api prisma:generate",
    "db:validate": "pnpm --filter @academyops/api prisma:validate",
    "db:migrate": "pnpm --filter @academyops/api prisma:migrate",
    "db:deploy": "pnpm --filter @academyops/api prisma:deploy",
    "db:seed": "pnpm --filter @academyops/api prisma:seed",
    "api:catalog:sync": "node scripts/sync-api-operation-surfaces.mjs",
    "api:contract:check": "node scripts/check-openapi-contract.mjs",
    "api:http:verify": "pnpm --filter @academyops/api test:http:matrix && pnpm --filter @academyops/api test:http:rate-limit && pnpm --filter @academyops/api-client test && pnpm --filter @academyops/web test",
    "api:generate": "pnpm --filter @academyops/contracts build && pnpm --filter @academyops/api openapi:emit && pnpm --filter @academyops/api-client generate && prettier --write packages/api-client/openapi.json packages/api-client/src/generated.ts",
    "verify": "pnpm dependencies:check && pnpm max-lines && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:verify",
    "verify:release": "pnpm audit:prod && pnpm licenses:check && pnpm db:validate && pnpm verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "socket.io-client": "4.8.3",
    "prettier": "3.8.1",
    "ts-json-schema-generator": "2.9.0",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
