{
  "name": "@academyops/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "default": "./dist/analytics/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./academy": {
      "types": "./dist/academy-primitives.d.ts",
      "import": "./dist/academy-primitives.js",
      "default": "./dist/academy-primitives.js"
    },
    "./academy.css": {
      "style": "./academy.css",
      "default": "./academy.css"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js",
      "default": "./dist/date-picker.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "import": "./dist/textarea.js",
      "default": "./dist/textarea.js"
    },
    "./toast.css": {
      "style": "./toast.css",
      "default": "./toast.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "biome format --write src .storybook",
    "lint": "biome check src .storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@academyops/design-tokens": "workspace:*",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tanstack/react-table": "9.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.31.0",
    "motion": "14.7.1",
    "radix-ui": "1.6.7",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
