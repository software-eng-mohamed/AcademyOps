# Safe default: localhost. Do not put tokens or session cookies in this file.
E2E_LOAD_BASE_URL=http://127.0.0.1:3100
E2E_LOAD_PROFILE=10
E2E_LOAD_RUNNER_COUNT=1
E2E_LOAD_RUNNER_INDEX=0
E2E_LOAD_REVISION=replace-with-deployed-git-sha
E2E_LOAD_SESSIONS_FILE=test-results/load/sessions-r0.json

# Required only for a remote disposable synthetic target.
# E2E_LOAD_REMOTE=synthetic-only
# E2E_LOAD_ALLOWED_ORIGIN=https://synthetic-stage.example.test

# Required after profile 10; must be the previous profile's combined passing gate.
# E2E_LOAD_PREVIOUS_GATE=test-results/load/gates/gate-10.json
# E2E_LOAD_GATE_MAX_AGE_MINUTES=360

# Guarded 10,500-subject fixture job (run only on a DB containing only E2EACADEMY).
# E2E_FIXTURE_CONFIRM=synthetic-only
# E2E_LOAD_DATABASE_CONFIRM=disposable-load-database
# E2E_LOAD_FIXTURE_CONFIRM=seed-10500-E2EACADEMY
# E2E_LOAD_CLEAN_CONFIRM=delete-10500-E2EACADEMY
# SESSION_PEPPER=use-the-same-secret-as-the-target-api

# Emergency exception for a single external generator above 1000 users.
# It never bypasses target, fixture, tenant, session, or previous-gate checks.
# E2E_LOAD_SINGLE_RUNNER_OVERRIDE=acknowledge-resource-risk
